{
  "name": "setup_padrao",
  "version": "1.0.0",
  "description": "Estrutura padrao para projetos backend em TypeScript",
  "main": "./dist/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsup",
    "start": "tsx --env-file-if-exists=.env ./src/index.ts",
    "start:dev": "tsx watch --env-file-if-exists=.env ./src/index.ts",
    "start:prod": "node --env-file-if-exists=.env ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --passWithNoTests --run",
    "test:unit": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --logHeapUsage",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [],
  "author": "Alexandre Skinner",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "git-commit-msg-linter": "^5.0.10",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
